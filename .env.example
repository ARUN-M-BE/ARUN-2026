# ─── Neon Cloud Services (Free Serverless) ──────────────────
# PostgreSQL
DATABASE_URL=postgresql://user:password@ep-pooler.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep.neon.tech/neondb?sslmode=require&channel_binding=require
NEON_BRANCH=production

# Neon Auth
NEON_AUTH_BASE_URL=https://ep.neonauth.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://ep.neonauth.aws.neon.tech/neondb/auth/.well-known/jwks.json

# Neon Object Storage (S3-compatible)
AWS_ACCESS_KEY_ID=your-neon-storage-access-key
AWS_SECRET_ACCESS_KEY=your-neon-storage-secret-key
AWS_ENDPOINT_URL_S3=https://br-id.storage.c-1.ap-southeast-1.aws.neon.tech
AWS_REGION=ap-southeast-1

# Neon Realtime
NEON_REALTIME_URL=wss://ep.rt.c-1.ap-southeast-1.aws.neon.tech/
NEON_REALTIME_SECRET=nrt_live_your_secret

# Authentication & Admin
AUTH_SECRET=generate-a-random-secret-with-openssl-rand-base64-32
NEXTAUTH_SECRET=generate-a-random-secret-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# ─── Free Service Integrations (STRICTLY FREE TIERS ONLY) ───────
# 1. Resend (Free Tier: 3,000 emails/mo, 100/day, Audiences API)
RESEND_API_KEY=re_your_free_resend_api_key
RESEND_FROM_EMAIL=Arun M <onboarding@resend.dev>
RESEND_WEBHOOK_SECRET=whsec_your_webhook_secret

# 2. Monkeytype API (100% Free Public Typing Telemetry)
MONKEYTYPE_APE_KEY=your_free_monkeytype_ape_key

# 3. IPstack & GeoIP (Strictly Free Plan + Automatic Zero-Cost FreeIPAPI Fallback)
IPSTACK_API_KEY=your_free_ipstack_key

# 4. Upstash (100% Free Serverless Tier: 10,000 commands/day)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_free_upstash_token

# Public URLs
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
