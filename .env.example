# ─── Neon Cloud Services ──────────────────────────────────
# PostgreSQL
DATABASE_URL=postgresql://user:password@ep-pooler.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep.neon.tech/neondb?sslmode=require&channel_binding=require
NEON_BRANCH=production

# Neon Auth
NEON_AUTH_BASE_URL=https://ep.neonauth.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://ep.neonauth.aws.neon.tech/neondb/auth/.well-known/jwks.json

# Neon Object Storage (S3-compatible)
AWS_ACCESS_KEY_ID=your-neon-storage-access-key
AWS_SECRET_ACCESS_KEY=your-neon-storage-secret-key
AWS_ENDPOINT_URL_S3=https://br-id.storage.c-1.ap-southeast-1.aws.neon.tech
AWS_REGION=ap-southeast-1

# Neon Realtime
NEON_REALTIME_URL=wss://ep.rt.c-1.ap-southeast-1.aws.neon.tech/
NEON_REALTIME_SECRET=nrt_live_your_secret

# Legacy / Alternative DB Config
DB_NAME=portfolio 
DB_USER=postgres
DB_PASSWORD=admin
DB_HOST=localhost
DB_PORT=5432

# Authentication
AUTH_SECRET=generate-a-random-secret-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# Initial Admin (used only by db:seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# Object Storage (S3-compatible: AWS S3, Cloudflare R2, etc.)
S3_BUCKET=your-bucket-name
S3_REGION=auto
S3_ENDPOINT=https://your-endpoint.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_PUBLIC_URL=https://your-cdn-url.com

# Optional: Analytics
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_SITE_URL=https://example.com

# API Management (API-FRRM)
NEXT_PUBLIC_API_URL=https://example.com
API_MANAGEMENT_URL=https://example.com
API_MANAGEMENT_KEY=frrm_xxxxx


API_MANAGEMENT_LOGIN=admin@example.com
API_MANAGEMENT_PASSWORD=ChangeMe123!