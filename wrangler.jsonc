{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arun-2026",
  "main": ".open-next/worker.js",
  "keep_names": false,
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "arun-m.in",
      "custom_domain": true
    }
  ],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://arun-m.in",
    "NEXT_PUBLIC_API_URL": "https://api.arun-m.in/arun"
  },
  "env": {
    "dev": {
      "name": "arun-2026-dev",
      "workers_dev": true,
      "routes": [
        {
          "pattern": "dev.arun-m.in",
          "custom_domain": true
        }
      ],
      "vars": {
        "NEXT_PUBLIC_SITE_URL": "https://dev.arun-m.in",
        "NEXT_PUBLIC_API_URL": "https://api-dev.arun-m.in/arun"
      }
    }
  }
}
