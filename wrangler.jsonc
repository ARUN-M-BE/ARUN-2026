{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arun-2026",
  "main": ".open-next/worker.js",
  "keep_names": false,
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "arun-m.in",
      "custom_domain": true
    }
  ],
  // Public, non-secret configuration only. Credentials are supplied at runtime:
  // - local `preview`: the git-ignored .dev.vars file
  // - production `deploy`: Cloudflare Secrets (`wrangler secret put <KEY>`)
  // Never commit credentials here — GitHub push protection rejects them.
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://arun-m.in",
    "NEXTAUTH_URL": "https://arun-m.in",
    "NEXT_PUBLIC_API_URL": "https://api.arun-m.in",
    "ADMIN_EMAIL": "arun@arun-m.in",
    "API_MANAGEMENT_URL": "https://api.arun-m.in",
    "NEON_BRANCH": "production",
    "NEON_AUTH_BASE_URL": "https://ep-wispy-pond-a1oope80.neonauth.ap-southeast-1.aws.neon.tech/neondb/auth",
    "NEON_AUTH_JWKS_URL": "https://ep-wispy-pond-a1oope80.neonauth.ap-southeast-1.aws.neon.tech/neondb/auth/.well-known/jwks.json",
    "NEON_REALTIME_URL": "wss://ep-wispy-pond-a1oope80.rt.c-1.ap-southeast-1.aws.neon.tech/",
    "AWS_ENDPOINT_URL_S3": "https://br-super-water-a1mpwmh3.storage.c-1.ap-southeast-1.aws.neon.tech",
    "AWS_REGION": "ap-southeast-1",
    "RESEND_FROM_EMAIL": "Arun M <arun@arun-m.in>",
    "UPSTASH_REDIS_REST_URL": "https://divine-quail-200838.upstash.io"
  }
}
