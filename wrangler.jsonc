{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arun-2026",
  "main": ".open-next/worker.js",
  "keep_names": false,
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "arun-m.in",
      "custom_domain": true
    }
  ],
  // Public, non-secret configuration only. All secrets are injected at runtime
  // via Cloudflare Secrets (`wrangler secret put` / `npm run secrets:push`) and
  // are intentionally NOT committed here. See .dev.vars.example for the full list.
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://arun-m.in",
    "NEXTAUTH_URL": "https://arun-m.in",
    "ADMIN_EMAIL": "arun@arun-m.in",
    "NEXT_PUBLIC_API_URL": "https://api.arun-m.in",
    "API_MANAGEMENT_URL": "https://api.arun-m.in",
    "UPSTASH_REDIS_REST_URL": "https://divine-quail-200838.upstash.io"
  }
}
